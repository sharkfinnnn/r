@page "/"
@rendermode InteractiveServer

@using Icedodo.Services
@inject IVideoServices videoServices


<header class="site-header">
    <h4 style="color: white;">Ice Dodo List</h4>

    <div class="header-buttons">
        <NavLink href="/" class="header-btn" Match="NavLinkMatch.All">
            Unlimited List
        </NavLink>

        <NavLink href="/levels" class="header-btn">
            Levels List
        </NavLink>
    </div>
</header>

<div class="page-layout">

    <div class="table-container">
        <h1 class="p-3; text-center;"style="color: white;">  Unlimited List</h1>

        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr @onclick="() => SelectUser(user)"
                        class="clickable-row @(selectedUser?.Id == user.Id ? "selected-row" : "")">

                        <td>
                            <strong class="number">@user.placement</strong>
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(user.videoUrl))
                            {
                                <iframe class="video-frame"
                                        src="@user.videoUrl"
                                        title="@user.name"
                                        allowfullscreen>
                                </iframe>
                            }
                            else if (!string.IsNullOrEmpty(user.imageUrl))
                            {
                                <img class="video-image"
                                     src="@user.imageUrl"
                                     alt="@user.name" />
                            }
                        </td>

                        <td>
                            <strong class="video-name">@user.name</strong>
                            <br />
                            <small class="text-muted">
                                Verified by @user.verifier
                            </small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (selectedUser != null)
    {
        <div class="info-panel">


            <h3>@selectedUser.name</h3>

            <p class="name1">Placement: @selectedUser.placement</p>
            <p class="name1">Verifier: @selectedUser.verifier</p>
            <p class="name1">Created by: @selectedUser.creator</p>
            <p class ="name1">VICTORS:</p>
            <p>
                <a class="name1" href="@selectedUser.Victor1v.Replace("embed/", "watch?v=")"
                   target="_blank">
                    @selectedUser.Victor1
                </a>
            </p>
            <p>
                <a class="name1" href="@selectedUser.Victor2v.Replace("embed/", "watch?v=")"
                   target="_blank">
                    @selectedUser.Victor2
                </a>
            </p>
            <p>
                <a class="name1" href="@selectedUser.Victor3v.Replace("embed/", "watch?v=")"
                   target="_blank">
                    @selectedUser.Victor3
                </a>
            </p>
            <p>
                <a class="name1" href="@selectedUser.Victor4v.Replace("embed/", "watch?v=")"
                   target="_blank">
                    @selectedUser.Victor4
                </a>
            </p>
            <p>
                <a class="name1" href="@selectedUser.Victor5v.Replace("embed/", "watch?v=")"
       target="_blank">
                    @selectedUser.Victor5
                </a>
            </p>

          

        </div>
    }

</div>
    
    
<div>
    <style>
            * {
                box-sizing: border-box;
            }

            .video-frame,
            .video-image {
                width: 400px;
                height: 225px;
                border: none;
                border-radius: 10px;
            }

            .video-image {
                object-fit: cover;
                display: block;
            }

            .name {
                font-size: 55px;
                color:white;
            }

            .name1 {
                font-size: 28px;
                color: white;

            }

            .number {
                font-size:75px;
            }
    
         
            .table {
                background-color: transparent !important;
                --bs-table-bg: transparent;
                --bs-table-striped-bg: transparent;
                --bs-table-color: white;
                --bs-table-striped-color: white;
                border-color: rgba(255, 255, 255, 0.2);
            }

               
                .table tbody tr > td {
                    background-color: transparent !important;
                    color: white !important;
                }

            
                .table tbody tr.clickable-row:not(.selected-row):hover > td {
                    background-color: rgba(255, 255, 255, 0.3) !important;
                    color: white !important;
                    cursor: pointer;
                }

               
                .table tbody tr.selected-row > td,
                .table tbody tr.selected-row:hover > td {
                    background-color: rgba(255, 255, 255, 0.5) !important;
                    color: white !important;
                    cursor: pointer;
                }

            body {
                background-image: url('/images/bg.png');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }

            .table tbody tr:hover td:first-child {
                border-radius: 12px 0 0 12px;
            }

            .table tbody tr:hover td:last-child {
                border-radius: 0 12px 12px 0;
            }
       
            .table tbody tr:hover td:first-child,
            .table tbody tr.selected-row td:first-child {
                border-radius: 12px 0 0 12px;
            }

           
            .table tbody tr:hover td:last-child,
            .table tbody tr.selected-row td:last-child {
                border-radius: 0 12px 12px 0;
            }
            .info-panel {
                border-radius: 20px;
            }
            .table {
                border-radius: 0 12px 12px 0;
                overflow: hidden;
                border-collapse: separate;
                border-spacing: 0;
            }

            .page-layout {
                display: grid;
                grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
                gap: 15px;
                width: 100%;
                max-width: 100%;
            }

            .table-container {
                min-width: 0;
                width: 100%;
                overflow-x: auto;
                
            }

            .info-panel {
                min-width: 0;
                width: 100%;
                height:750px;
                box-sizing: border-box;
                padding: 20px;
                background: rgba(70, 70, 70, 0.4);
                color: white;
                border-radius: 15px;
                overflow-wrap: break-word;
                position: sticky;
                top: 20px;
                align-self: start;
            }

            .info-video {
                width: 100%;
                aspect-ratio: 16 / 9;
                border: none;
            }

            .table {
                width: 100%;
            }

            .site-header {
                display: flex;
                align-items: center;
                gap: 30px;
                padding: 15px 25px;
                background: rgba(0, 0, 0, 0.4);
            }

                .site-header h4 {
                    color: white;
                    margin: 0;
                    font-size: 28px;
                    line-height: 1;
                }

            .header-buttons {
                display: flex;
                align-items: center;
                gap: 12px;
            }

.header-btn {
    padding: 8px 20px;
    border: 1px solid white;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    cursor: pointer;
    font-size: 16px;
    text-decoration: none;
}

.header-btn:hover {
    background: rgba(255, 255, 255, 0.35);
    color: white;
}

.header-btn.active {
    background: rgba(255, 255, 255, 0.35);
}
    

         
    </style>
</div>

